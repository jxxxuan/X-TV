# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：站长用户名（用于电视端 App 登录，默认 admin）
USERNAME=admin

# 可选：站点名称（电视端展示名，默认 X-TV）
SITE_NAME=X-TV

# 可选：持久化 SQLite 数据库路径（默认为 ./data/xtv.sqlite）
SQLITE_DB_PATH=./data/xtv.sqlite

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：预置采集站（JSON 数组）
# DEFAULT_SOURCES=[{"name":"示例源","url":"https://example.com/api.php/provide/vod"}]

# 可选：预置数据源订阅（可直接填 TVBox 配置地址或 LibreTV-SourceList JSON 地址）
# DEFAULT_SUBSCRIPTIONS=["https://example.com/tvbox.json"]

# 可选：预置直播源（M3U 订阅，JSON 数组）
# DEFAULT_LIVE_SOURCES=[{"name":"示例直播源","url":"https://example.com/list.m3u"}]

# 可选：自建内网 IPTV 放行（自建局域网 IPTV 源时开启）
# LIVE_ALLOW_PRIVATE=1

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：调试
DEBUG=false
